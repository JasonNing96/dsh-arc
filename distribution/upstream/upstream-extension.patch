@@ -0,0 +1,37 @@
+import type {
+  SessionExecutionDriver,
+  SessionExecutionEvent,
+  SessionExecutionPermissionOutcome,
+  SessionExecutionSnapshot,
+} from '../../src/dsh-adapter/session-execution.js'
+
+/** Deterministic in-memory driver for a PTY or direct UI fixture. */
+export function createFakeDriver(id = 'fixture'): SessionExecutionDriver {
+  let closed = false
+  let snapshot: SessionExecutionSnapshot = {
+    uiSessionId: 'fixture-ui-session', executionSessionId: 'fixture-execution-1', title: 'Fixture', working: false,
+  }
+  const listeners = new Set<(event: SessionExecutionEvent) => void>()
+  const publish = (event: SessionExecutionEvent): void => { for (const listener of listeners) listener(event) }
+  return {
+    id,
+    capabilities: new Set(['submit', 'cancel', 'permission-reply']),
+    snapshot: () => snapshot,
+    subscribe(listener) { listeners.add(listener); return () => listeners.delete(listener) },
+    submit(text, turnId) {
+      if (closed || text.trim() === '') return false
+      snapshot = { ...snapshot, working: true }
+      publish({ type: 'snapshot', turnId, snapshot })
+      publish({ type: 'text', turnId, delta: `echo: ${text}` })
+      snapshot = { ...snapshot, working: false }
+      publish({ type: 'snapshot', turnId, snapshot })
+      return true
+    },
+    async cancel() {
+      snapshot = { ...snapshot, working: false }
+      publish({ type: 'snapshot', turnId: 'fixture-turn', snapshot })
+    },
+    async replyPermission(_requestId: string, _outcome: SessionExecutionPermissionOutcome) {},
+    async close() { closed = true; listeners.clear() },
+  }
+}
