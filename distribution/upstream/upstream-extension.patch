+/** Cordis-owned registry for optional, renderer-free session drivers. */
+import { Context, Service } from '@deepseek-ai/cordis'
+import { adapterRuntimeFor } from '../adapter/kernel/runtime-context.js'
+import { assertCapabilityShadowPolicy, type AdapterRuntimeOptions } from '../adapter/kernel/runtime.js'
+import { bindCallerEffect, concreteService, requirePluginCaller } from './host-access.js'
+import type { SessionExecutionDriver, SessionExecutionEvent, SessionExecutionPermissionOutcome, TuiSessionExecutionRegistry } from './session-execution.js'
+
+type Capability = SessionExecutionDriver['capabilities'] extends ReadonlySet<infer Item> ? Item : never
+interface Entry { readonly driver: SessionExecutionDriver; active: boolean; closePromise: Promise<void> | undefined }
+interface Selection {
+  readonly entry: Entry
+  readonly pending: Set<string>
+  readonly seenPermissionIds: Set<string>
+  readonly cleanups: Set<() => void>
+  readonly revoked: Set<() => void>
+  active: boolean
+  releasePromise: Promise<void> | undefined
+}
+interface State { readonly runtime: AdapterRuntimeOptions; readonly entries: Map<string, Entry>; selected: Selection | undefined }
+export interface HostSessionExecutionSelection {
+  readonly driver: SessionExecutionDriver
+  release(): Promise<void>
+  /** Fires synchronously when the owner unloads or this lease is released. */
+  onRevoked(listener: () => void): () => void
+}
+export interface HostSessionExecution { acquire(id: string): HostSessionExecutionSelection | undefined }
+
+const states = new WeakMap<TuiSessionExecutionRuntime, State>()
+const inactiveMessage = 'dsh-tui: selected session execution driver is no longer active'
+
+function stateFor(runtime: TuiSessionExecutionRuntime): State {
+  const state = states.get(concreteService(runtime))
+  if (state === undefined) throw new Error('dsh-tui: session execution registry is unavailable')
+  return state
+}
+function assertInvoke(state: State): void {
+  assertCapabilityShadowPolicy('host.execution.invoke', state.runtime.mode, state.runtime.slices)
+}
+function closeEntry(entry: Entry): Promise<void> {
+  entry.active = false
+  entry.closePromise ??= Promise.resolve().then(() => entry.driver.close())
+  return entry.closePromise
+}
+function immutableCapabilities(source: ReadonlySet<Capability>): ReadonlySet<Capability> {
+  const values = Object.freeze([...source])
+  const view: ReadonlySet<Capability> = {
+    get size() { return values.length },
+    has(value: Capability) { return values.includes(value) },
+    entries() { return values.map(value => [value, value] as [Capability, Capability])[Symbol.iterator]() },
+    keys() { return values[Symbol.iterator]() },
+    values() { return values[Symbol.iterator]() },
+    forEach(callback, thisArg) { values.forEach(value => callback.call(thisArg, value, value, view)) },
+    [Symbol.iterator]() { return values[Symbol.iterator]() },
+  }
+  return Object.freeze(view)
+}
+
+function release(state: State, selection: Selection): Promise<void> {
+  if (selection.releasePromise !== undefined) return selection.releasePromise
+  // Reserve the complete teardown before any synchronous listener can reenter.
+  let resolve!: () => void
+  let reject!: (reason: unknown) => void
+  selection.releasePromise = new Promise<void>((resolvePromise, rejectPromise) => {
+    resolve = resolvePromise
+    reject = rejectPromise
+  })
+  selection.active = false
+  selection.entry.active = false
+  if (state.selected === selection) state.selected = undefined
+  if (state.entries.get(selection.entry.driver.id) === selection.entry) state.entries.delete(selection.entry.driver.id)
+  const pending = [...selection.pending]
+  selection.pending.clear()
+  const revoked = [...selection.revoked]
+  selection.revoked.clear()
+  const cleanups = [...selection.cleanups]
+  selection.cleanups.clear()
+  const failures: unknown[] = []
+  for (const listener of revoked) {
+    try { listener() } catch (error) { failures.push(error) }
+  }
+  void (async () => {
+    // The transport remains open through denials and unsubscription. Each task
+    // gets a chance even if an earlier plugin callback fails.
+    for (const requestId of pending) {
+      try { await selection.entry.driver.replyPermission(requestId, 'deny') } catch (error) { failures.push(error) }
+    }
+    for (const cleanup of cleanups) {
+      try { await cleanup() } catch (error) { failures.push(error) }
+    }
+    try { await closeEntry(selection.entry) } catch (error) { failures.push(error) }
+    if (failures.length === 0) resolve()
+    else if (failures.length === 1) reject(failures[0])
+    else reject(new AggregateError(failures, 'dsh-tui: session execution release failed'))
+  })()
+  return selection.releasePromise
+}
+function guarded(state: State, selection: Selection): SessionExecutionDriver {
+  const driver = selection.entry.driver
+  const active = () => selection.active && selection.entry.active
+  const unavailable = () => Promise.reject(new Error(inactiveMessage))
+  return Object.freeze({
+    id: driver.id,
+    capabilities: immutableCapabilities(driver.capabilities),
+    commands: Object.freeze((driver.commands ?? []).map(command => Object.freeze({ ...command }))),
+    command(name, rawInput) {
+      if (!active()) return unavailable()
+      assertInvoke(state)
+      if (!driver.capabilities.has('commands') || !driver.commands?.some(command => command.name === name)) return Promise.resolve(undefined)
+      return driver.command?.(name, rawInput) ?? Promise.resolve(undefined)
+    },
+    updateDraft(text) {
+      if (!active()) throw new Error(inactiveMessage)
+      assertInvoke(state)
+      if (driver.capabilities.has('draft')) driver.updateDraft?.(text)
+    },
+    snapshot: () => {
+      if (!active()) throw new Error(inactiveMessage)
+      return driver.snapshot()
+    },
+    subscribe(listener) {
+      if (!active()) return () => undefined
+      const unsubscribe = driver.subscribe((event: SessionExecutionEvent) => {
+        if (!active()) return
+        if (event.type === 'permission') {
+          if (selection.seenPermissionIds.has(event.requestId)) return
+          selection.seenPermissionIds.add(event.requestId)
+          selection.pending.add(event.requestId)
+        }
+        listener(event)
+      })
+      let stopped = false
+      const stop = (): void => {
+        if (stopped) return
+        stopped = true
+        selection.cleanups.delete(stop)
+        unsubscribe()
+      }
+      selection.cleanups.add(stop)
+      return stop
+    },
+    submit(text, turnId) {
+      if (!active()) return false
+      assertInvoke(state)
+      return driver.submit(text, turnId)
+    },
+    cancel() {
+      if (!active()) return unavailable()
+      assertInvoke(state)
+      return driver.cancel()
+    },
+    replyPermission(requestId, outcome: SessionExecutionPermissionOutcome) {
+      if (!active()) return unavailable()
+      assertInvoke(state)
+      if (!selection.pending.delete(requestId)) return unavailable()
+      return driver.replyPermission(requestId, outcome)
+    },
+    close() { return release(state, selection) },
+  })
+}
+
+export class TuiSessionExecutionRuntime extends Service implements TuiSessionExecutionRegistry {
+  constructor(ctx: Context) {
+    super(ctx, 'tuiSessionExecution')
+    states.set(this, { runtime: adapterRuntimeFor(ctx), entries: new Map(), selected: undefined })
+  }
+  register(_pluginCtx: Context, driver: SessionExecutionDriver): () => Promise<void> {
+    const state = stateFor(this)
+    assertCapabilityShadowPolicy('host.execution.register', state.runtime.mode, state.runtime.slices)
+    // The supplied Context is deliberately ignored: only Cordis's active fiber can own this driver.
+    const caller = requirePluginCaller(this.ctx, 'tuiSessionExecution.register', this)
+    if (!/^[a-z][a-z0-9_-]{0,63}$/u.test(driver.id)) throw new TypeError(`dsh-tui: invalid session execution driver id: ${driver.id}`)
+    if (state.entries.has(driver.id)) throw new Error(`dsh-tui: session execution driver already registered: ${driver.id}`)
+    const entry: Entry = { driver, active: true, closePromise: undefined }
+    state.entries.set(driver.id, entry)
+    let disposePromise: Promise<void> | undefined
+    const dispose = (): Promise<void> => {
+      if (disposePromise !== undefined) return disposePromise
+      entry.active = false
+      if (state.entries.get(driver.id) === entry) state.entries.delete(driver.id)
+      const selected = state.selected?.entry === entry ? state.selected : undefined
+      disposePromise = selected === undefined ? closeEntry(entry) : release(state, selected)
+      return disposePromise
+    }
+    if (!bindCallerEffect(caller, dispose)) {
+      dispose()
+      throw new Error('dsh-tui: session execution driver activation is no longer live')
+    }
+    return dispose
+  }
+}
+function acquire(runtime: TuiSessionExecutionRuntime, id: string): HostSessionExecutionSelection | undefined {
+  const state = stateFor(runtime)
+  assertCapabilityShadowPolicy('host.execution.acquire', state.runtime.mode, state.runtime.slices)
+  const entry = state.entries.get(id)
+  if (entry === undefined || !entry.active || state.selected !== undefined) return undefined
+  const selection: Selection = { entry, pending: new Set(), seenPermissionIds: new Set(), cleanups: new Set(), revoked: new Set(), active: true, releasePromise: undefined }
+  state.selected = selection
+  return Object.freeze({
+    driver: guarded(state, selection),
+    release: () => release(state, selection),
+    onRevoked(listener) {
+      if (!selection.active) {
+        listener()
+        return () => undefined
+      }
+      selection.revoked.add(listener)
+      return () => selection.revoked.delete(listener)
+    },
+  })
+}
+/** Host-only lookup; plugins cannot list or retrieve another driver's object. */
+export function getHostSessionExecution(runtime: TuiSessionExecutionRegistry | undefined): HostSessionExecution | undefined {
+  if (runtime === undefined) return undefined
+  try {
+    const concrete = concreteService(runtime as object)
+    return concrete instanceof TuiSessionExecutionRuntime ? Object.freeze({ acquire: id => acquire(concrete, id) }) : undefined
+  } catch {
+    return undefined
+  }
+}
