new file mode 100644
index 0000000..acffdde
--- /dev/null
+++ b/scripts/verify-external-approvals.ts
@@ -0,0 +1,82 @@
+/** Focused external-driver approval queue proof.
+ * Run: node --import tsx/esm scripts/verify-external-approvals.ts
+ */
+import assert from 'node:assert/strict'
+import { ApprovalStore } from '../src/dsh-adapter/approvals.js'
+
+class SignalProbe {
+  aborted = false
+  adds = 0
+  removes = 0
+  private readonly listeners = new Set<() => void>()
+  addEventListener(_type: string, listener: () => void): void { this.adds += 1; this.listeners.add(listener) }
+  removeEventListener(_type: string, listener: () => void): void { this.removes += 1; this.listeners.delete(listener) }
+  abort(): void { this.aborted = true; for (const listener of [...this.listeners]) listener() }
+}
+const asSignal = (probe: SignalProbe): AbortSignal => probe as unknown as AbortSignal
+
+// A visible request settles once on the panel decision and detaches its abort listener.
+{
+  const store = new ApprovalStore({ mode: 'legacy', slices: [] })
+  const signal = new SignalProbe()
+  const waiting = store.parkExternal({ sourceSessionId: 's', requestId: 'one', title: 'Allow?', signal: asSignal(signal) })
+  assert.equal(store.getSnapshot()?.toolName, 'Allow?')
+  store.decide('allowed-once')
+  assert.equal(await waiting, 'allowed-once')
+  assert.equal(signal.adds, 1)
+  assert.equal(signal.removes, 1)
+  signal.abort()
+  assert.equal(store.getSnapshot(), null, 'a settled listener cannot advance the queue')
+}
+
+// A pre-aborted request never enters the queue or installs a listener.
+{
+  const store = new ApprovalStore({ mode: 'legacy', slices: [] })
+  const signal = new SignalProbe()
+  signal.abort()
+  assert.equal(await store.parkExternal({ sourceSessionId: 's', requestId: 'pre', title: 'pre', signal: asSignal(signal) }), 'cancelled')
+  assert.equal(signal.adds, 0)
+  assert.equal(store.getSnapshot(), null)
+}
+
+// Cancelling a queued item removes only it, leaves the active request visible,
+// and still advances correctly when the active item is decided.
+{
+  const store = new ApprovalStore({ mode: 'legacy', slices: [] })
+  const active = store.parkExternal({ sourceSessionId: 's', requestId: 'active', title: 'active' })
+  const signal = new SignalProbe()
+  const queued = store.parkExternal({ sourceSessionId: 's', requestId: 'queued', title: 'queued', signal: asSignal(signal) })
+  signal.abort()
+  assert.equal(await queued, 'cancelled')
+  assert.equal(signal.removes, 1)
+  assert.equal(store.getSnapshot()?.toolName, 'active')
+  store.decide('rejected')
+  assert.equal(await active, 'rejected')
+  assert.equal(store.getSnapshot(), null)
+}
+
+// settleAll detaches both active and queued external listeners exactly once.
+{
+  const store = new ApprovalStore({ mode: 'legacy', slices: [] })
+  const firstSignal = new SignalProbe()
+  const secondSignal = new SignalProbe()
+  const first = store.parkExternal({ sourceSessionId: 's', requestId: 'first', title: 'first', signal: asSignal(firstSignal) })
+  const second = store.parkExternal({ sourceSessionId: 's', requestId: 'second', title: 'second', signal: asSignal(secondSignal) })
+  store.settleAll('cancelled')
+  assert.equal(await first, 'cancelled')
+  assert.equal(await second, 'cancelled')
+  assert.equal(firstSignal.removes, 1)
+  assert.equal(secondSignal.removes, 1)
+}
+
+// External execution is still a host.presentation.approve mutation and is
+// refused in passive shadow before it can add listeners or enqueue work.
+{
+  const store = new ApprovalStore({ mode: 'passive-shadow', slices: [] })
+  const signal = new SignalProbe()
+  assert.throws(() => store.parkExternal({ sourceSessionId: 's', requestId: 'shadow', title: 'shadow', signal: asSignal(signal) }), /shadow policy denies mutate/u)
+  assert.equal(signal.adds, 0)
+  assert.equal(store.getSnapshot(), null)
+}
+
+console.log('ok external approval decision/cancel/preabort/queue/shadow')
diff --git a/scripts/verify-session-execution-registry.ts b/scripts/verify-session-execution-registry.ts
new file mode 100644
index 0000000..abf098e
--- /dev/null
+++ b/scripts/verify-session-execution-registry.ts
@@ -0,0 +1,163 @@
+/** Focused lifecycle proof for the optional external session execution registry.
+ * Run: node --import tsx/esm scripts/verify-session-execution-registry.ts
+ */
+import { Context } from '@deepseek-ai/cordis'
+import { TuiSessionExecutionRuntime, getHostSessionExecution } from '../src/dsh-adapter/session-execution-registry.js'
+import type { SessionExecutionDriver, SessionExecutionEvent } from '../src/dsh-adapter/session-execution.js'
+
+let failures = 0
+const check = (name: string, ok: boolean): void => {
+  if (!ok) failures += 1
+  console.log(`${ok ? 'ok  ' : 'FAIL'} ${name}`)
+}
+const settle = async (): Promise<void> => { await Promise.resolve(); await Promise.resolve() }
+const expectReject = async (action: () => Promise<unknown>): Promise<boolean> => {
+  try { await action(); return false } catch { return true }
+}
+
+interface Probe {
+  readonly driver: SessionExecutionDriver
+  emit(event: SessionExecutionEvent): void
+  resolveDeferred(): void
+  readonly calls: { close: number; reply: string[]; unsubscribe: number; snapshot: number }
+}
+function probe(id: string, options: { throwReply?: boolean; throwUnsubscribe?: boolean; deferReply?: boolean; deferUnsubscribe?: boolean } = {}): Probe {
+  const deferred: (() => void)[] = []
+  const listeners = new Set<(event: SessionExecutionEvent) => void>()
+  const calls = { close: 0, reply: [] as string[], unsubscribe: 0, snapshot: 0 }
+  return {
+    calls,
+    resolveDeferred: () => deferred.shift()?.(),
+    emit: event => { for (const listener of listeners) listener(event) },
+    driver: {
+      id,
+      capabilities: new Set(['submit', 'cancel', 'permission-reply']),
+      snapshot: () => { calls.snapshot += 1; return { uiSessionId: id, executionSessionId: id, title: id, working: false } },
+      subscribe(listener) {
+        listeners.add(listener)
+        return () => {
+          calls.unsubscribe += 1
+          listeners.delete(listener)
+          if (options.deferUnsubscribe) return new Promise<void>((resolve, reject) => { deferred.push(() => options.throwUnsubscribe ? reject(new Error('unsubscribe failed')) : resolve()) })
+          if (options.throwUnsubscribe) throw new Error('unsubscribe failed')
+        }
+      },
+      submit: () => true,
+      cancel: async () => undefined,
+      replyPermission: async (requestId) => {
+        calls.reply.push(requestId)
+        if (options.deferReply) return new Promise<void>((resolve, reject) => { deferred.push(() => options.throwReply ? reject(new Error('reply failed')) : resolve()) })
+        if (options.throwReply) throw new Error('reply failed')
+      },
+      close: async () => { calls.close += 1 },
+    },
+  }
+}
+
+const root = new Context()
+root.plugin(TuiSessionExecutionRuntime)
+await settle()
+const service = root.get('tuiSessionExecution')
+const host = getHostSessionExecution(service)
+if (host === undefined) throw new Error('registry host accessor unavailable')
+
+// Root cannot install a driver. A child may pass a forged Context argument,
+// but ownership is recovered from its live Cordis fiber instead.
+const rootDriver = probe('root')
+let rootRefused = false
+try { service.register(root, rootDriver.driver) } catch { rootRefused = true }
+check('root/fake context cannot register', rootRefused && rootDriver.calls.close === 0)
+
+const first = probe('driver')
+let disposeFirst: (() => Promise<void>) | undefined
+const firstFiber = root.plugin({
+  name: 'registry-first', inject: ['tuiSessionExecution'],
+  apply(ctx: Context) { disposeFirst = ctx.tuiSessionExecution.register(root, first.driver) },
+})
+await settle()
+const lease = host.acquire('driver')
+check('live plugin registration ignores supplied root context', lease !== undefined)
+check('single visible owner prevents a second acquire', host.acquire('driver') === undefined)
+if (lease === undefined) throw new Error('first lease missing')
+
+let delivered = 0
+const stopFirst = lease.driver.subscribe(() => { delivered += 1 })
+first.emit({ type: 'permission', turnId: 't', requestId: 'permission-1', title: 'allow?' })
+first.emit({ type: 'permission', turnId: 't', requestId: 'permission-1', title: 'duplicate?' })
+check('duplicate permission event is not redelivered', delivered === 1)
+await lease.driver.replyPermission('permission-1', 'allow')
+const repeatedRejected = await expectReject(() => lease.driver.replyPermission('permission-1', 'deny'))
+const unknownRejected = await expectReject(() => lease.driver.replyPermission('unknown', 'deny'))
+check('permission reply is single-settle and unknown is rejected locally', first.calls.reply.join(',') === 'permission-1' && repeatedRejected && unknownRejected)
+
+let revoked = 0
+lease.onRevoked(() => { revoked += 1; stopFirst() })
+first.emit({ type: 'text', turnId: 't', delta: 'before' })
+disposeFirst?.()
+await lease.release()
+first.emit({ type: 'text', turnId: 'late', delta: 'after' })
+let snapshotRejected = false
+try { lease.driver.snapshot() } catch { snapshotRejected = true }
+check('unload fences late events, snapshot access, and double unsubscribe', delivered === 2 && snapshotRejected && revoked === 1 && first.calls.unsubscribe === 1)
+check('unload/release closes the raw driver exactly once', first.calls.close === 1)
+check('closed entry cannot be reacquired', host.acquire('driver') === undefined)
+await Promise.resolve(firstFiber.dispose())
+
+const second = probe('driver')
+let disposeSecond: (() => Promise<void>) | undefined
+const secondFiber = root.plugin({
+  name: 'registry-second', inject: ['tuiSessionExecution'],
+  apply(ctx: Context) { disposeSecond = ctx.tuiSessionExecution.register(ctx, second.driver) },
+})
+await settle()
+const replacement = host.acquire('driver')
+check('a new registration can replace a closed instance', replacement !== undefined)
+if (replacement === undefined) throw new Error('replacement lease missing')
+await replacement.release()
+disposeSecond?.()
+await Promise.resolve(secondFiber.dispose())
+
+const failing = probe('failing', { throwReply: true, throwUnsubscribe: true })
+let disposeFailing: (() => Promise<void>) | undefined
+const failingFiber = root.plugin({
+  name: 'registry-failing', inject: ['tuiSessionExecution'],
+  apply(ctx: Context) { disposeFailing = ctx.tuiSessionExecution.register(ctx, failing.driver) },
+})
+await settle()
+const failingLease = host.acquire('failing')
+if (failingLease === undefined) throw new Error('failing lease missing')
+failingLease.driver.subscribe(() => undefined)
+failing.emit({ type: 'permission', turnId: 't', requestId: 'permission-2', title: 'deny?' })
+const cleanupRejected = await expectReject(() => failingLease.release())
+check('cleanup continues after failing reply/unsubscribe', cleanupRejected && failing.calls.reply.join(',') === 'permission-2' && failing.calls.unsubscribe === 1 && failing.calls.close === 1)
+disposeFailing?.()
+await Promise.resolve(failingFiber.dispose())
+
+
+const deferred = probe('deferred', { deferReply: true, deferUnsubscribe: true, throwReply: true })
+let disposeDeferred: (() => Promise<void>) | undefined
+const deferredFiber = root.plugin({
+  name: 'registry-deferred', inject: ['tuiSessionExecution'],
+  apply(ctx: Context) { disposeDeferred = ctx.tuiSessionExecution.register(ctx, deferred.driver) },
+})
+await settle()
+const deferredLease = host.acquire('deferred')
+if (deferredLease === undefined) throw new Error('deferred lease missing')
+deferredLease.driver.subscribe(() => undefined)
+deferred.emit({ type: 'permission', turnId: 't', requestId: 'permission-3', title: 'deny?' })
+const firstRelease = deferredLease.release()
+const secondRelease = deferredLease.release()
+let secondSettled = false
+void secondRelease.then(() => { secondSettled = true }, () => { secondSettled = true })
+await settle()
+check('second release waits for deferred denial before raw close', firstRelease === secondRelease && !secondSettled && deferred.calls.reply.join(',') === 'permission-3' && deferred.calls.close === 0)
+deferred.resolveDeferred()
+await settle()
+check('second release also waits for deferred unsubscribe', !secondSettled && deferred.calls.close === 0)
+deferred.resolveDeferred()
+const deferredResults = await Promise.allSettled([firstRelease, secondRelease])
+check('reentrant release shares cleanup failure and closes raw driver once', deferredResults.every(result => result.status === 'rejected') && deferred.calls.close === 1)
+await disposeDeferred?.().catch(() => undefined)
+await Promise.resolve(deferredFiber.dispose())
+
+if (failures > 0) process.exitCode = 1
