+++ b/src/dsh-adapter/external-execution-tui.ts
@@ -0,0 +1,246 @@
+/** Optional, plugin-owned execution seam for the terminal conversation UI. */
+import React from 'react'
+import { SessionComposerContext } from '../components/session-composer.js'
+import type { Context } from '@deepseek-ai/cordis'
+import type { ChannelUi } from '../adapter/ports/channel-ui.js'
+import { createInitialChannelView } from './channel/state.js'
+import { Chat } from '../screens/Chat.js'
+import { completeCommands, LOCAL_COMMANDS } from '../commands.js'
+import { ApprovalStore } from './approvals.js'
+import { QuestionStore } from './questions.js'
+import { render, ThemeProvider } from '../ui.js'
+import { PageMargin } from '../components/PageMargin.js'
+import { AlternateScreen } from '../ui.js'
+import { mountChannelUi } from './channel-ui.js'
+import { adapterRuntimeFor } from '../adapter/kernel/runtime-context.js'
+import { markChannelReadDirty } from '../adapter/channel/read-view.js'
+import { registerTuiChannel } from '../adapter/channel/host-registry.js'
+import { createChannelOwner, disposeChannelOwner, registerChannelOwner } from './channel/owner.js'
+import { compositionRoot } from './host-access.js'
+import { getHostShortcuts } from './shortcuts.js'
+import { getHostStatusStore } from './status.js'
+import type { SessionExecutionDriver, SessionExecutionEvent, SessionExecutionSnapshot } from './session-execution.js'
+
+const EMPTY_AGENT_ROWS: ReturnType<ChannelUi['agentViewRows']> = Object.freeze([])
+const UI_COMMANDS = LOCAL_COMMANDS.filter(command => ['help', 'exit', 'quit', 'q'].includes(command.name))
+
+/** The external UI intentionally has no Agent-shaped object or host controls. */
+export async function mountExternalExecutionTui(
+  ctx: Context,
+  driver: SessionExecutionDriver,
+  release: () => Promise<void>,
+  onRevoked: (listener: () => void) => () => void,
+  options: { fullscreen?: boolean; terminalImages?: boolean; onUserExit?: (code: number) => Promise<void> } = {},
+): Promise<void> {
+  let snapshot = driver.snapshot()
+  const initial = createInitialChannelView({ model: 'external', provider: driver.id, cwd: process.cwd(), activity: false }, {
+    agentId: snapshot.uiSessionId,
+    mode: { id: 'external', plan: false, sandbox: 'read-only', approval: 'ask' }, cwdDescription: process.cwd(),
+  })
+  const listeners = new Set<() => void>()
+  let closed = false
+  let generation = 0
+  let activeTurnId: string | undefined
+  let acceptingTurn = false
+  const deferredEvents: SessionExecutionEvent[] = []
+  const approvalStore = new ApprovalStore(adapterRuntimeFor(ctx))
+  const permissionAbort = new AbortController()
+  const state = { ...initial, autoRecapOnOpen: false, agentId: snapshot.uiSessionId, sessionTitle: snapshot.title, working: snapshot.working, turnStart: snapshot.working ? Date.now() : 0, status: snapshot.working ? 'running' as const : 'idle' as const, rows: initial.rows.slice(), notifications: initial.notifications.slice() }
+  const emit = (): void => { state.version += 1; for (const listener of listeners) listener() }
+  const notice = (text: string): void => { state.notifications.push({ id: Date.now() + state.version, text, color: 'warning', timeoutMs: 4000 }); emit() }
+  const unavailable = (name: string): void => {
+    notice(`${name} is unavailable for external execution drivers`)
+  }
+  const touchRow = (row: { readonly text: string }): void => {
+    markChannelReadDirty(row)
+    markChannelReadDirty(state.rows)
+  }
+  const appendRow = (row: typeof state.rows[number]): void => {
+    state.rows.push(row)
+    markChannelReadDirty(state.rows)
+  }
+  const projectText = (text: string): void => {
+    const previous = state.rows.at(-1)
+    if (previous?.kind === 'assistant' && previous.streaming === true) {
+      previous.text += text
+      touchRow(previous)
+    } else appendRow({ id: state.version + 1, kind: 'assistant', text, streaming: state.working, fresh: true, time: Date.now() })
+  }
+  const refresh = (next: SessionExecutionSnapshot): void => {
+    if (next.rows !== undefined) {
+      state.rows = next.rows.map(({ tool, ...row }) => ({ ...row, fresh: false,
+        ...(tool === undefined ? {} : { tool: { ...tool, argsText: '', startedAt: row.time } }),
+      }))
+    }
+    state.cwd = next.cwd ?? state.cwd
+    state.displayCwd = next.cwd ?? state.displayCwd
+    state.model = next.model ?? state.model
+    snapshot = next; state.agentId = next.uiSessionId; state.sessionTitle = next.title; state.working = next.working; state.status = next.working ? 'running' : 'idle'
+    if (next.text !== undefined && state.rows.length === 0) projectText(next.text)
+    const previous = state.rows.at(-1)
+    if (previous?.kind === 'assistant' && !next.working) {
+      previous.streaming = false
+      touchRow(previous)
+    }
+    if (!next.working) activeTurnId = undefined
+    emit()
+  }
+  refresh(snapshot)
+  const commands = [...UI_COMMANDS, ...(driver.commands ?? []).filter(command =>
+    /^[a-z][a-z0-9_-]*$/u.test(command.name) && !LOCAL_COMMANDS.some(local => local.name === command.name),
+  ).map(command => ({ ...command, external: true }))]
+  const runCommand: ChannelUi['runExternalCommandOutcome'] = async (name, rawInput, images) => {
+    if (closed || !driver.capabilities.has('commands') || (images?.length ?? 0) > 0) return undefined
+    return driver.command?.(name, rawInput)
+  }
+  const dispatchEvent = (event: SessionExecutionEvent): void => {
+    if (closed) return
+    if (event.type === 'session') {
+      if (event.generation <= generation || activeTurnId !== undefined) return
+      generation = event.generation
+      refresh(event.snapshot)
+      return
+    }
+    if (activeTurnId === undefined || event.turnId !== activeTurnId) return
+    if (event.type === 'snapshot') refresh(event.snapshot)
+    else if (event.type === 'text') { state.responseChars += event.delta.length; projectText(event.delta); emit() }
+    else {
+      void approvalStore.parkExternal({ sourceSessionId: snapshot.uiSessionId, requestId: event.requestId, title: event.title, signal: permissionAbort.signal }).then(outcome => {
+        if (closed) return
+        return driver.replyPermission(event.requestId, outcome === 'allowed-once' ? 'allow' : 'deny')
+      }).catch(error => notice(`Permission reply failed: ${String(error)}`))
+    }
+  }
+  const stop = driver.subscribe(event => {
+    if (acceptingTurn) { deferredEvents.push(event); return }
+    dispatchEvent(event)
+  })
+  const channel: ChannelUi = {
+    ...state,
+    promptSessionLabel: true,
+    commandList: commands,
+    pluginScene: undefined,
+    subagentControl: { interrupt: () => false },
+    jobControl: { kill: () => false },
+    get cwd() { return state.cwd }, get displayCwd() { return state.displayCwd }, get model() { return state.model },
+    get version() { return state.version }, get rows() { return state.rows }, get status() { return state.status }, get sessionTitle() { return state.sessionTitle }, get agentId() { return state.agentId }, get working() { return state.working }, get cancelPending() { return state.cancelPending }, get responseChars() { return state.responseChars }, get turnStart() { return state.turnStart }, get lastUserText() { return state.lastUserText }, get notifications() { return state.notifications },
+    subscribe(listener) { listeners.add(listener); return () => listeners.delete(listener) }, notify(text) { notice(text); return () => undefined },
+    submit(text, images) {
