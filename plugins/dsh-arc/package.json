{
  "name": "dsh-arc",
  "version": "1.0.0",
  "description": "Optional DSH runtime checkpoint service for ARC handoff",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./acp": {
      "types": "./lib/acp.d.ts",
      "default": "./lib/acp.js"
    },
    "./tui": {
      "types": "./lib/tui.d.ts",
      "default": "./lib/tui.js"
    },
    "./checkpoint": {
      "types": "./lib/checkpoint.d.ts",
      "default": "./lib/checkpoint.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-timeout=20000 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-acp": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2"
  },
  "license": "MIT"
}
